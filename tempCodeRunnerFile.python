df = pd.DataFrame(data)
df['Date'] = pd.to_datetime(df['Date'])

print("=" * 60)
print("        تقرير تحليل بيانات المبيعات")
print("=" * 60)
print(f"\nعدد الصفوف الأصلي: {len(df)}")

# ============================================
# 2) تنظيف البيانات
# ============================================
print("\n--- مرحلة تنظيف البيانات ---")

# إزالة المكررات
duplicates_count = df.duplicated().sum()
df = df.drop_duplicates()
print(f"عدد الصفوف المكررة المحذوفة: {duplicates_count}")

# إزالة القيم الفارغة
nulls_before = df.isnull().sum().sum()
df = df.dropna()
print(f"عدد القيم الفارغة المحذوفة: {nulls_before}")

# التأكد من أن القيم الرقمية موجبة
negative_qty = (df['Quantity'] <= 0).sum()
negative_rev = (df['Revenue'] <= 0).sum()
negative_prf = (df['Profit'] < 0).sum()
df = df[df['Quantity'] > 0]
df = df[df['Revenue'] > 0]
print(f"صفوف بكميات سالبة/صفرية: {negative_qty}")
print(f"صفوف بإيرادات سالبة/صفرية: {negative_rev}")

print(f"\nعدد الصفوف بعد التنظيف: {len(df)}")

# ============================================
# 3) حساب المؤشرات (KPIs)
# ============================================
total_revenue = df['Revenue'].sum()
total_profit = df['Profit'].sum()
total_orders = len(df)
avg_order_value = total_revenue / total_orders
profit_margin = (total_profit / total_revenue) * 100

print("\n--- مؤشرات الأداء الرئيسية (KPIs) ---")
print(f"إجمالي الإيرادات: ${total_revenue:,.2f}")
print(f"إجمالي الأرباح: ${total_profit:,.2f}")
print(f"عدد الطلبات: {total_orders}")
print(f"متوسط قيمة الطلب: ${avg_order_value:,.2f}")
print(f"هامش الربح: {profit_margin:.1f}%")

# ============================================
# 4) تحليلات إضافية للرسوم البيانية
# ============================================
# مبيعات حسب المنتج
product_summary = df.groupby('Product').agg(
    Revenue=('Revenue', 'sum'),
    Profit=('Profit', 'sum'),
    Orders=('Order_ID', 'count')
).reset_index()

# مبيعات حسب المنطقة
region_summary = df.groupby('Region').agg(
    Revenue=('Revenue', 'sum'),
    Profit=('Profit', 'sum'),
    Orders=('Order_ID', 'count')
).reset_index()

# مبيعات حسب الشهر
df['Month'] = df['Date'].dt.month
df['Month_Name'] = df['Date'].dt.strftime('%b')
month_order = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul']
monthly_summary = df.groupby(['Month', 'Month_Name']).agg(
    Revenue=('Revenue', 'sum'),
    Profit=('Profit', 'sum'),
    Orders=('Order_ID', 'count')
).reset_index().sort_values('Month')

# ============================================
# 5) إنشاء ملف Excel مع Dashboard
# ============================================
wb = Workbook()

# ---- ألوان وأنماط ----
dark_blue = "1B2A4A"
medium_blue = "2E86AB"
light_blue = "D6EAF8"
green_color = "27AE60"
gold_color = "F39C12"
white_color = "FFFFFF"
gray_color = "F2F3F4"

header_font = Font(name='Calibri', bold=True, color=white_color, size=11)
header_fill = PatternFill(start_color=dark_blue,
                          end_color=dark_blue, fill_type='solid')
kpi_title_font = Font(name='Calibri', bold=True, color=dark_blue, size=10)
kpi_value_font = Font(name='Calibri', bold=True, color=medium_blue, size=20)
kpi_label_font = Font(name='Calibri', bold=False, color="666666", size=9)
title_font = Font(name='Calibri', bold=True, color=dark_blue, size=16)
thin_border = Border(
    left=Side(style='thin', color='D5D8DC'),
    right=Side(style='thin', color='D5D8DC'),
    top=Side(style='thin', color='D5D8DC'),
    bottom=Side(style='thin', color='D5D8DC')
)

# ============================================
# ورقة 1: البيانات النظيفة (Clean Data)
# ============================================
ws_data = wb.active
ws_data.title = "Clean Data"

# كتابة البيانات
columns_to_write = ['Order_ID', 'Date', 'Product',
                    'Region', 'Quantity', 'Revenue', 'Profit']
df_clean = df[columns_to_write].copy()
df_clean['Date'] = df_clean['Date'].dt.strftime('%Y-%m-%d')

# العناوين
for col_idx, col_name in enumerate(columns_to_write, 1):
    cell = ws_data.cell(row=1, column=col_idx, value=col_name)
    cell.font = header_font
    cell.fill = header_fill
    cell.alignment = Alignment(horizontal='center', vertical='center')
    cell.border = thin_border

# البيانات
for row_idx, row_data in enumerate(df_clean.values, 2):
    for col_idx, value in enumerate(row_data, 1):
        cell = ws_data.cell(row=row_idx, column=col_idx, value=value)
        cell.alignment = Alignment(horizontal='center', vertical='center')
        cell.border = thin_border
        if row_idx % 2 == 0:
            cell.fill = PatternFill(
                start_color=gray_color, end_color=gray_color, fill_type='solid')

# عرض الأعمدة
ws_data.column_dimensions['A'].width = 12
ws_data.column_dimensions['B'].width = 14
ws_data.column_dimensions['C'].width = 12
ws_data.column_dimensions['D'].width = 10
ws_data.column_dimensions['E'].width = 12
ws_data.column_dimensions['F'].width = 12
ws_data.column_dimensions['G'].width = 12

# ============================================
# ورقة 2: ملخص التحليلات (Summary)
# ============================================
ws_summary = wb.create_sheet("Summary")

# --- KPIs Section ---
ws_summary.cell(row=1, column=1,
                value="مؤشرات الأداء الرئيسية (KPIs)").font = title_font
ws_summary.merge_cells('A1:F1')

kpi_data = [
    ("إجمالي الإيرادات", f"${total_revenue:,.0f}"),
    ("إجمالي الأرباح", f"${total_profit:,.0f}"),
    ("عدد الطلبات", f"{total_orders}"),
]

for i, (label, value) in enumerate(kpi_data):
    col = i * 2 + 1
    cell_val = ws_summary.cell(row=3, column=col, value=value)
    cell_val.font = kpi_value_font
    cell_val.alignment = Alignment(horizontal='center', vertical='center')
    ws_summary.merge_cells(start_row=3, start_column=col,
                           end_row=3, end_column=col + 1)

    cell_lbl = ws_summary.cell(row=4, column=col, value=label)
    cell_lbl.font = kpi_label_font
    cell_lbl.alignment = Alignment(horizontal='center', vertical='center')
    ws_summary.merge_cells(start_row=4, start_column=col,
                           end_row=4, end_column=col + 1)

# --- جدول حسب المنتج ---
ws_summary.cell(row=6, column=1, value="ملخص حسب المنتج").font = Font(
    name='Calibri', bold=True, color=dark_blue, size=13)
headers_prod = ['Product', 'Revenue', 'Profit', 'Orders']
for col_idx, h in enumerate(headers_prod, 1):
    cell = ws_summary.cell(row=7, column=col_idx, value=h)
    cell.font = header_font
    cell.fill = header_fill
    cell.alignment = Alignment(horizontal='center')
    cell.border = thin_border

for row_idx, row_data in enumerate(product_summary.values, 8):
    for col_idx, value in enumerate(row_data, 1):
        cell = ws_summary.cell(row=row_idx, column=col_idx, value=value)
        cell.alignment = Alignment(horizontal='center')
        cell.border = thin_border
        if isinstance(value, float):
            cell.number_format = '#,##0.00'

# --- جدول حسب المنطقة ---
start_row_region = 8 + len(product_summary) + 2
ws_summary.cell(row=start_row_region - 1, column=1, value="ملخص حسب المنطقة").font = Font(
    name='Calibri', bold=True, color=dark_blue, size=13)
headers_reg = ['Region', 'Revenue', 'Profit', 'Orders']
for col_idx, h in enumerate(headers_reg, 1):
    cell = ws_summary.cell(row=start_row_region, column=col_idx, value=h)
    cell.font = header_font
    cell.fill = header_fill
    cell.alignment = Alignment(horizontal='center')
    cell.border = thin_border

for row_idx, row_data in enumerate(region_summary.values, start_row_region + 1):
    for col_idx, value in enumerate(row_data, 1):
        cell = ws_summary.cell(row=row_idx, column=col_idx, value=value)
        cell.alignment = Alignment(horizontal='center')
        cell.border = thin_border
        if isinstance(value, float):
            cell.number_format = '#,##0.00'

# --- جدول حسب الشهر ---
start_row_month = start_row_region + len(region_summary) + 3
ws_summary.cell(row=start_row_month - 1, column=1, value="ملخص حسب الشهر").font = Font(
    name='Calibri', bold=True, color=dark_blue, size=13)
headers_month = ['Month_Num', 'Month', 'Revenue', 'Profit', 'Orders']
for col_idx, h in enumerate(headers_month, 1):
    cell = ws_summary.cell(row=start_row_month, column=col_idx, value=h)
    cell.font = header_font
    cell.fill = header_fill
    cell.alignment = Alignment(horizontal='center')
    cell.border = thin_border

for row_idx, row_data in enumerate(monthly_summary.values, start_row_month + 1):
    for col_idx, value in enumerate(row_data, 1):
        cell = ws_summary.cell(row=row_idx, column=col_idx, value=value)
        cell.alignment = Alignment(horizontal='center')
        cell.border = thin_border
        if isinstance(value, float):
            cell.number_format = '#,##0.00'

# عرض أعمدة Summary
for col_letter in ['A', 'B', 'C', 'D', 'E', 'F']:
    ws_summary.column_dimensions[col_letter].width = 18

# ============================================
# ورقة 3: Dashboard
# ============================================
ws_dash = wb.create_sheet("Dashboard")
ws_dash.sheet_properties.tabColor = "2E86AB"

# --- عنوان الداشبورد ---
ws_dash.merge_cells('A1:P2')
title_cell = ws_dash.cell(row=1, column=1, value="📊  Sales Dashboard  📊")
title_cell.font = Font(name='Calibri', bold=True, color=white_color, size=22)
title_cell.fill = PatternFill(
    start_color=dark_blue, end_color=dark_blue, fill_type='solid')
title_cell.alignment = Alignment(horizontal='center', vertical='center')

# تلوين صف العنوان
for col in range(1, 17):
    cell = ws_dash.cell(row=1, column=col)
    cell.fill = PatternFill(start_color=dark_blue,
                            end_color=dark_blue, fill_type='solid')
    cell = ws_dash.cell(row=2, column=col)
    cell.fill = PatternFill(start_color=dark_blue,
                            end_color=dark_blue, fill_type='solid')

# --- KPI Cards ---
kpi_cards = [
    ("💰 Total Revenue", f"${total_revenue:,.0f}", medium_blue),
    ("📈 Total Profit", f"${total_profit:,.0f}", green_color),
    ("📦 Total Orders", f"{total_orders}", gold_color),
]

kpi_start_col = [1, 6, 11]
for i, (label, value, color) in enumerate(kpi_cards):
    col_start = kpi_start_col[i]
    col_end = col_start + 4

    # خلية القيمة
    ws_dash.merge_cells(start_row=4, start_column=col_start,
                        end_row=4, end_column=col_end)
    val_cell = ws_dash.cell(row=4, column=col_start, value=value)
    val_cell.font = Font(name='Calibri', bold=True, color=color, size=24)
    val_cell.alignment = Alignment(horizontal='center', vertical='center')

    # خلية التسمية
    ws_dash.merge_cells(start_row=5, start_column=col_start,
                        end_row=5, end_column=col_end)
    lbl_cell = ws_dash.cell(row=5, column=col_start, value=label)
    lbl_cell.font = Font(name='Calibri', bold=True, color="555555", size=11)
    lbl_cell.alignment = Alignment(horizontal='center', vertical='center')

    # حدود بسيطة للكارد
    for r in range(3, 6):
        for c in range(col_start, col_end + 1):
            cell = ws_dash.cell(row=r, column=c)
            cell.fill = PatternFill(
                start_color="F8F9FA", end_color="F8F9FA", fill_type='solid')
            cell.border = Border(
                left=Side(style='thin', color='DEE2E6') if c == col_start else Side(
                    style=None),
                right=Side(style='thin', color='DEE2E6') if c == col_end else Side(
                    style=None),
                top=Side(style='thin', color='DEE2E6') if r == 3 else Side(
                    style=None),
                bottom=Side(style='thin', color='DEE2E6') if r == 5 else Side(
                    style=None),
            )

# ============================================
# إنشاء الرسوم البيانية بـ matplotlib وإدراجها كصور
# ============================================
colors_palette = ['#2E86AB', '#A23B72', '#F18F01', '#C73E1D', '#3B1F2B']
plt.rcParams['font.size'] = 10

# --- رسم 1: إيرادات حسب المنتج (Bar Chart) ---
fig1, ax1 = plt.subplots(figsize=(6, 4))
bars = ax1.bar(product_summary['Product'], product_summary['Revenue'],
               color=colors_palette[:len(product_summary)], edgecolor='white', linewidth=1.5)
ax1.set_title('Revenue by Product', fontsize=14,
              fontweight='bold', color='#1B2A4A', pad=15)
ax1.set_ylabel('Revenue ($)', fontsize=10)
ax1.spines['top'].set_visible(False)
ax1.spines['right'].set_visible(False)
ax1.grid(axis='y', alpha=0.3)
for bar, val in zip(bars, product_summary['Revenue']):
    ax1.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 200,
             f'${val:,.0f}', ha='center', va='bottom', fontsize=8, fontweight='bold')
plt.tight_layout()
fig1.savefig('chart1_product_revenue.png', dpi=150,
             bbox_inches='tight', facecolor='white')
plt.close(fig1)

# --- رسم 2: حصة الإيرادات حسب المنطقة (Pie Chart) ---
fig2, ax2 = plt.subplots(figsize=(5.5, 4))
wedges, texts, autotexts = ax2.pie(
    region_summary['Revenue'],
    labels=region_summary['Region'],
    autopct='%1.1f%%',
    colors=colors_palette[:len(region_summary)],
    startangle=90,
    pctdistance=0.85,
    wedgeprops=dict(width=0.5, edgecolor='white', linewidth=2)
)
for text in autotexts:
    text.set_fontsize(9)
    text.set_fontweight('bold')
ax2.set_title('Revenue Share by Region', fontsize=14,
              fontweight='bold', color='#1B2A4A', pad=15)
plt.tight_layout()
fig2.savefig('chart2_region_pie.png', dpi=150,
             bbox_inches='tight', facecolor='white')
plt.close(fig2)

# --- رسم 3: الإيرادات والأرباح الشهرية (Line Chart) ---
fig3, ax3 = plt.subplots(figsize=(6, 4))
ax3.plot(monthly_summary['Month_Name'], monthly_summary['Revenue'],
         marker='o', linewidth=2.5, color='#2E86AB', label='Revenue', markersize=7)
ax3.plot(monthly_summary['Month_Name'], monthly_summary['Profit'],
         marker='s', linewidth=2.5, color='#27AE60', label='Profit', markersize=7)
ax3.fill_between(monthly_summary['Month_Name'],
                 monthly_summary['Revenue'], alpha=0.1, color='#2E86AB')
ax3.fill_between(monthly_summary['Month_Name'],
                 monthly_summary['Profit'], alpha=0.1, color='#27AE60')
ax3.set_title('Monthly Revenue & Profit Trend', fontsize=14,
              fontweight='bold', color='#1B2A4A', pad=15)
ax3.set_ylabel('Amount ($)', fontsize=10)
ax3.legend(frameon=True, fancybox=True, shadow=True)
ax3.spines['top'].set_visible(False)
ax3.spines['right'].set_visible(False)
ax3.grid(axis='y', alpha=0.3)
plt.tight_layout()
fig3.savefig('chart3_monthly_trend.png', dpi=150,
             bbox_inches='tight', facecolor='white')
plt.close(fig3)

# --- رسم 4: عدد الطلبات حسب المنتج والمنطقة (Stacked Bar) ---
pivot_orders = df.pivot_table(
    index='Product', columns='Region', values='Order_ID', aggfunc='count', fill_value=0)
fig4, ax4 = plt.subplots(figsize=(6, 4))
pivot_orders.plot(kind='bar', stacked=True, ax=ax4, color=colors_palette[:len(pivot_orders.columns)],
                  edgecolor='white', linewidth=0.8)
ax4.set_title('Orders by Product & Region', fontsize=14,
              fontweight='bold', color='#1B2A4A', pad=15)
ax4.set_ylabel('Number of Orders', fontsize=10)
ax4.set_xlabel('')
ax4.spines['top'].set_visible(False)
ax4.spines['right'].set_visible(False)
ax4.legend(title='Region', frameon=True, fancybox=True)
ax4.grid(axis='y', alpha=0.3)
plt.xticks(rotation=0)
plt.tight_layout()
fig4.savefig('chart4_orders_stacked.png', dpi=150,
             bbox_inches='tight', facecolor='white')
plt.close(fig4)

# ============================================
# إدراج الرسوم في Dashboard
# ============================================
img1 = Image('chart1_product_revenue.png')
img1.width = 450
img1.height = 300
ws_dash.add_image(img1, 'A7')

img2 = Image('chart2_region_pie.png')
img2.width = 420
img2.height = 300
ws_dash.add_image(img2, 'I7')

img3 = Image('chart3_monthly_trend.png')
img3.width = 450
img3.height = 300
ws_dash.add_image(img3, 'A24')

img4 = Image('chart4_orders_stacked.png')
img4.width = 450
img4.height = 300
ws_dash.add_image(img4, 'I24')

# ضبط عرض أعمدة الداشبورد
for col_letter in ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J', 'K', 'L', 'M', 'N', 'O', 'P']:
    ws_dash.column_dimensions[col_letter].width = 9

# ============================================
# 6) حفظ الملف
# ============================================
output_file = "Sales_Dashboard_Report.xlsx"
wb.save(output_file)

print(f"\n{'=' * 60}")
print(f"✅ تم إنشاء الملف بنجاح: {output_file}")
print(f"{'=' * 60}")
print(f"\nالملف يحتوي على 3 أوراق:")
print(f"  1. Clean Data   - البيانات بعد التنظيف ({len(df)} صف)")
print(f"  2. Summary      - جداول ملخصة حسب المنتج والمنطقة والشهر")
print(f"  3. Dashboard    - لوحة بيانات تفاعلية مع:")
print(f"     • 3 مؤشرات أداء (KPIs)")
print(f"     • 4 رسوم بيانية")

# تنظيف ملفات الصور المؤقتة
for f in ['chart1_product_revenue.png', 'chart2_region_pie.png',
          'chart3_monthly_trend.png', 'chart4_orders_stacked.png']:
    if os.path.exists(f):
        os.remove(f)

print(f"\n🧹 تم تنظيف الملفات المؤقتة")
print(f"🎉 افتح الملف '{output_file}' للاطلاع على النتائج!")
